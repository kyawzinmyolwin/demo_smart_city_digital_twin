<?xml version='1.0' encoding='UTF-8'?>
<!-- Low-traffic TEST scenario. Same real network as the main config, but only the
     8 vehicles in low_traffic.rou.xml (all depart 06:30) and a short window, so the
     emitter / dashboard / cloud pipeline can be exercised without the full ~92k load.
     Paths are relative to this file (scenarios/), hence the ../data prefix. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../data/output/network/Christchurch_Central_City_main_streets.net.xml" />
        <route-files value="low_traffic.rou.xml" />
        <additional-files value="../data/output/network/Christchurch_Central_City_main_streets.add.xml" />
    </input>
    <time>
        <begin value="23400" />
        <end value="24000" />
        <step-length value="1" />
    </time>
</sumoConfiguration>
