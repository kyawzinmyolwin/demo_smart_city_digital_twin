<?xml version='1.0' encoding='UTF-8'?>
<!-- Low-traffic FLOW test scenario. Same real network, but a steady trickle of a
     few vehicles along 3 routes for 6 min of sim time (06:30-06:36), so the map
     stays populated instead of draining after one batch. Run with
     run_traci.py in real-time mode to play it at wall-clock speed and watch live. -->
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../data/output/network/Christchurch_Central_City_main_streets.net.xml" />
        <route-files value="low_traffic_flow.rou.xml" />
        <additional-files value="../data/output/network/Christchurch_Central_City_main_streets.add.xml" />
    </input>
    <time>
        <begin value="23400" />
        <end value="23760" />
        <step-length value="1" />
    </time>
</sumoConfiguration>
