# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments (see CLAUDE.md "Environment setup")
.venv/
venv/
env/

# --- Secrets / local config ---
# docker-compose reads .env for the local InfluxDB password + token.
.env
!.env.example

# --- macOS ---
.DS_Store

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp

# --- SUMO / simulation runtime output ---
# Generated at run time by sumo, not source. The committed network/demand files
# under data/output/ are build products the project tracks on purpose, so this
# stays narrow and only covers logs and dumps.
*.log
sumo.log

# --- Terraform (cloud/infra) ---
# State can hold secrets and is environment-specific; providers and the zipped
# Lambda bundle are build artifacts regenerated by terraform init/plan.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfvars
cloud/infra/build/
