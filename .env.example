# Copy to .env and change the password + token. .env is gitignored — never commit
# real secrets. These values initialise the local InfluxDB on first `up`.

INFLUXDB_USERNAME=admin
# Min 8 characters, or InfluxDB setup fails.
INFLUXDB_PASSWORD=change-me-8plus
INFLUXDB_ORG=christchurch
INFLUXDB_BUCKET=traffic-metrics
# Any non-empty string for local dev; treated as the all-access admin token.
INFLUXDB_TOKEN=local-dev-token-change-me
INFLUXDB_RETENTION=30d
